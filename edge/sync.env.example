# Cloud broker (EMQX Cloud) settings for sync_worker.py.
# On the Pi:
#   sudo mkdir -p /etc/medikiosk
#   sudo cp edge/sync.env.example /etc/medikiosk/sync.env
#   sudo nano /etc/medikiosk/sync.env          (fill in the real values)
#   sudo chown root:medi_kiosk /etc/medikiosk/sync.env && sudo chmod 640 /etc/medikiosk/sync.env
#   sudo systemctl restart medikiosk-sync
# NEVER commit the filled-in file - the repo is public.

# EMQX console -> your deployment -> Overview -> "Address" (MQTT over TLS/SSL port is 8883)
MEDIKIOSK_BROKER_HOST=xxxx.ala.ap-southeast-1.emqxsl.com
MEDIKIOSK_BROKER_PORT=8883
MEDIKIOSK_BROKER_TLS=1

# EMQX console -> Access Control -> Authentication: one login per kiosk
MEDIKIOSK_BROKER_USERNAME=K-01
MEDIKIOSK_BROKER_PASSWORD=change-me
