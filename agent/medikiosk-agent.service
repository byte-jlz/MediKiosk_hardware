# systemd service: starts the MediKiosk agent on boot and restarts it if it crashes.
# CHECK THE PATHS below match your Pi (user medi_kiosk, repo in the home folder,
# venv inside the repo), then see agent/README.md for the install commands.

[Unit]
Description=MediKiosk sensor agent (MQTT)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=medi_kiosk
Group=medi_kiosk
# i2c / gpio / dialout (USB serial) / video (webcams) access
SupplementaryGroups=i2c gpio dialout video
WorkingDirectory=/home/medi_kiosk/MediKiosk_hardware
ExecStart=/home/medi_kiosk/MediKiosk_hardware/venv/bin/python agent/kiosk_agent.py
Environment=KIOSK_ID=K-01
Environment=MQTT_HOST=localhost
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
